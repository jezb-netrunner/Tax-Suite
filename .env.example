# Supabase project credentials (multi-tenant accounts + saved profiles).
# Leave unset to run in local-device mode (profiles stored in this browser only).
# `npm run dev` reads these directly. `npm run build` ignores them unless the
# shell also sets JEZ_ENABLE_ACCOUNTS=1 (see README "Opening the app"), so the
# committed index.html is always the local-mode app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
